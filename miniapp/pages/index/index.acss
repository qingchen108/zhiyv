.page-home {
  padding: 16px;
  background: #f5f5f5;
  min-height: 100vh;
}

.welcome-card {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  border-radius: 12px;
  padding: 24px 20px;
  margin-bottom: 16px;
}

.welcome-title {
  display: block;
  font-size: 20px;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8px;
}

.welcome-desc {
  display: block;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}

.quick-actions {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  background: #fff;
  border-radius: 12px;
  padding: 16px 0;
  margin-bottom: 16px;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8px 16px;
}

.action-icon {
  width: 32px;
  height: 32px;
  margin-bottom: 6px;
}

.action-label {
  font-size: 12px;
  color: #333;
}

.section {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
}

.section-header {
  margin-bottom: 12px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.feature-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
  padding: 12px 0;
}

.feature-emoji {
  font-size: 28px;
  margin-bottom: 6px;
}

.feature-label {
  font-size: 12px;
  color: #666;
}