<view class="page-reg-detail">
  <!-- 加载中 -->
  <view class="detail-loading" a:if="{{!record}}">
    <text class="detail-loading-text">加载中...</text>
  </view>

  <block a:if="{{record}}">
    <!-- 状态头 -->
    <view class="detail-header detail-header-{{record.status}}">
      <text class="detail-status">{{statusText(record.status)}}</text>
      <text class="detail-status-sub">{{record.departmentName}} · {{record.doctorName}}</text>
    </view>

    <!-- 凭证信息 -->
    <view class="detail-card">
      <view class="detail-card-title">就诊凭证</view>
      <view class="detail-row">
        <text class="detail-label">挂号单号</text>
        <text class="detail-value detail-no">{{record.regNo}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">就诊科室</text>
        <text class="detail-value">{{record.departmentName}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">就诊医生</text>
        <text class="detail-value">{{record.doctorName}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">就诊时间</text>
        <text class="detail-value">{{record.scheduleDate}} {{periodText(record.timePeriod)}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">就诊人</text>
        <text class="detail-value">{{record.visitorName}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">挂号时间</text>
        <text class="detail-value">{{record.createdAt}}</text>
      </view>
    </view>

    <!-- 取消按钮（仅可取消时展示） -->
    <view class="detail-actions" a:if="{{canCancel}}">
      <button class="cancel-btn" size="large" onTap="onCancel" loading="{{canceling}}">取消挂号</button>
    </view>

    <view class="detail-tip" a:if="{{record.status === 'CANCELLED'}}">
      <text class="detail-tip-text">该挂号已取消，号源已释放。</text>
    </view>
  </block>
</view>
