.page-reg-detail {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40px;
}

/* 加载中 */
.detail-loading {
  padding: 80px 0;
  text-align: center;
}

.detail-loading-text {
  font-size: 14px;
  color: #999;
}

/* 状态头 */
.detail-header {
  padding: 28px 20px;
  text-align: center;
}

.detail-header-REGISTERED {
  background: linear-gradient(135deg, #1677ff, #4096ff);
}

.detail-header-VISITED {
  background: linear-gradient(135deg, #52c41a, #73d13d);
}

.detail-header-CANCELLED {
  background: linear-gradient(135deg, #bfbfbf, #d9d9d9);
}

.detail-status {
  display: block;
  font-size: 22px;
  font-weight: 600;
  color: #fff;
}

.detail-status-sub {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.9);
}

/* 凭证卡片 */
.detail-card {
  background: #fff;
  border-radius: 12px;
  margin: -10px 12px 0;
  padding: 16px;
  position: relative;
}

.detail-card-title {
  font-size: 15px;
  font-weight: 600;
  color: #333;
  margin-bottom: 12px;
}

.detail-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #f5f5f5;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 13px;
  color: #999;
}

.detail-value {
  font-size: 14px;
  color: #333;
}

.detail-no {
  font-family: monospace;
  color: #1677ff;
}

/* 取消按钮 */
.detail-actions {
  margin: 24px 20px 0;
}

.cancel-btn {
  background: #ff4d4f;
  color: #fff;
  border-radius: 22px;
  font-size: 15px;
}

.cancel-btn::after {
  border: none;
}

/* 提示 */
.detail-tip {
  margin: 20px;
  text-align: center;
}

.detail-tip-text {
  font-size: 12px;
  color: #999;
}
