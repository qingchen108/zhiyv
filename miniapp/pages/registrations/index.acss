.page-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 40px;
  background: #f5f5f5;
}

.placeholder-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

.placeholder-title {
  font-size: 20px;
  font-weight: 600;
  color: #333;
  margin-bottom: 8px;
}

.placeholder-desc {
  font-size: 14px;
  color: #999;
  margin-bottom: 4px;
}

.placeholder-hint {
  font-size: 12px;
  color: #ccc;
}