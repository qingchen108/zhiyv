.page-profile {
  padding: 0 0 24px;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 成员切换 tab */
.member-tabs {
  display: flex;
  flex-direction: row;
  background: #fff;
  padding: 0 8px;
  position: sticky;
  top: 0;
  z-index: 10;
  overflow-x: auto;
}

.member-tab {
  flex-shrink: 0;
  text-align: center;
  padding: 14px 16px;
  font-size: 14px;
  color: #666;
  border-bottom: 2px solid transparent;
}

.member-tab-active {
  color: #1677ff;
  font-weight: 600;
  border-bottom-color: #1677ff;
}

/* 基本信息卡片 */
.info-card {
  background: #fff;
  border-radius: 12px;
  padding: 0 16px 16px;
  margin: 12px 12px 0;
}

.info-card-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid #f0f0f0;
  margin-bottom: 4px;
}

.info-card-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.info-manage {
  font-size: 13px;
  color: #1677ff;
}

.info-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item-textarea {
  flex-direction: column;
  align-items: flex-start;
}

.info-label {
  font-size: 14px;
  color: #666;
  width: 80px;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 14px;
  color: #333;
  text-align: right;
}

.info-textarea {
  width: 100%;
  min-height: 60px;
  font-size: 14px;
  color: #333;
  margin-top: 8px;
  padding: 8px;
  background: #fafafa;
  border-radius: 8px;
}

.save-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  background: #1677ff;
  color: #fff;
  font-size: 16px;
  border-radius: 22px;
  text-align: center;
  margin-top: 16px;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  background: #d9d9d9;
  color: #999;
}

/* 档案汇总 */
.summary-card {
  display: flex;
  flex-direction: row;
  background: #fff;
  border-radius: 12px;
  margin: 12px 12px 0;
  padding: 18px 8px;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-num {
  font-size: 20px;
  font-weight: 600;
  color: #1677ff;
}

.summary-label {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

/* 记录入口菜单 */
.menu-card {
  background: #fff;
  border-radius: 12px;
  margin: 12px 12px 0;
  padding: 0 16px;
}

.menu-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 15px 0;
  border-bottom: 1px solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 15px;
  color: #333;
}

.menu-arrow {
  font-size: 20px;
  color: #ccc;
}
