<view class="page-profile">
  <!-- 成员切换 -->
  <view class="member-tabs">
    <view
      class="member-tab {{activeIndex === index ? 'member-tab-active' : ''}}"
      a:for="{{members}}"
      a:key="id"
      data-id="{{item.id}}"
      onTap="switchMember"
    >
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="info-card">
    <view class="info-card-header">
      <text class="info-card-title">基本信息</text>
      <text class="info-manage" a:if="{{activeMemberId !== 0}}" onTap="navigateToFamilyMembers">家庭成员管理</text>
    </view>

    <!-- 本人：可编辑 -->
    <block a:if="{{activeMemberId === 0}}">
      <view class="info-item">
        <text class="info-label">姓名</text>
        <input class="info-value" value="{{name}}" onInput="onNameInput" placeholder="请输入姓名" />
      </view>
      <view class="info-item">
        <text class="info-label">性别</text>
        <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" onChange="onGenderChange">
          <text class="info-value">{{gender || '请选择'}}</text>
        </picker>
      </view>
      <view class="info-item">
        <text class="info-label">出生日期</text>
        <picker mode="date" value="{{birthDate}}" onChange="onBirthDateChange">
          <text class="info-value">{{birthDate || '请选择'}}</text>
        </picker>
      </view>
      <view class="info-item">
        <text class="info-label">年龄</text>
        <text class="info-value">{{age}}岁</text>
      </view>
      <view class="info-item info-item-textarea">
        <text class="info-label">过敏史</text>
        <textarea class="info-textarea" value="{{allergyHistory}}" onInput="onAllergyInput" placeholder="请填写过敏史（选填）" />
      </view>
      <button class="save-btn" onTap="onSave" disabled="{{!modified}}">保存</button>
    </block>

    <!-- 家庭成员：只读 -->
    <block a:if="{{activeMemberId !== 0}}">
      <view class="info-item">
        <text class="info-label">姓名</text>
        <text class="info-value">{{name}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">性别</text>
        <text class="info-value">{{gender || '—'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">出生日期</text>
        <text class="info-value">{{birthDate || '—'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">年龄</text>
        <text class="info-value">{{age}}岁</text>
      </view>
      <view class="info-item">
        <text class="info-label">过敏史</text>
        <text class="info-value">{{allergyHistory || '无'}}</text>
      </view>
    </block>
  </view>

  <!-- 档案汇总 -->
  <view class="summary-card" a:if="{{!loading}}">
    <view class="summary-item" onTap="goRegistrations">
      <text class="summary-num">{{regCount}}</text>
      <text class="summary-label">挂号</text>
    </view>
    <view class="summary-item" onTap="goConsultations">
      <text class="summary-num">{{consultCount}}</text>
      <text class="summary-label">问诊</text>
    </view>
    <view class="summary-item" onTap="goPrescriptions">
      <text class="summary-num">{{prescCount}}</text>
      <text class="summary-label">处方</text>
    </view>
    <view class="summary-item" onTap="goOrders">
      <text class="summary-num">{{orderCount}}</text>
      <text class="summary-label">购药</text>
    </view>
    <view class="summary-item" onTap="goReminders">
      <text class="summary-num">{{remindCount}}</text>
      <text class="summary-label">提醒</text>
    </view>
  </view>

  <!-- 记录入口 -->
  <view class="menu-card">
    <view class="menu-item" onTap="goRegistrations">
      <text class="menu-label">挂号记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" onTap="goConsultations">
      <text class="menu-label">问诊记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" onTap="goPrescriptions">
      <text class="menu-label">处方记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" onTap="goOrders">
      <text class="menu-label">购药订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" onTap="goReminders">
      <text class="menu-label">用药提醒</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
