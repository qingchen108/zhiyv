<view class="page-family-members">
  <!-- 当前就诊人提示 -->
  <view class="active-member-bar" a:if="{{currentMemberId > 0}}" onTap="onSwitchToSelf">
    <text class="active-member-text">当前就诊人：{{currentMemberName}}</text>
    <text class="active-member-action">切换回本人</text>
  </view>

  <view class="header">
    <text class="header-title">家庭成员</text>
    <text class="header-action" onTap="navigateToAdd">+ 添加</text>
  </view>

  <view class="member-list">
    <view class="member-item" a:for="{{members}}" a:key="id" onTap="navigateToEdit" data-id="{{item.id}}">
      <view class="member-avatar" class="{{currentMemberId === item.id ? 'member-avatar active' : 'member-avatar'}}">
        <text class="member-avatar-text">{{item.firstChar}}</text>
      </view>
      <view class="member-info">
        <view class="member-name-row">
          <text class="member-name">{{item.name}}</text>
          <text class="member-relation">{{item.relationship}}</text>
          <text class="member-badge" a:if="{{currentMemberId === item.id}}">当前</text>
        </view>
        <view class="member-meta">
          <text class="member-meta-text" a:if="{{item.age}}">{{item.age}}岁</text>
          <text class="member-meta-text" a:if="{{item.phone}}">{{item.phone}}</text>
        </view>
      </view>
      <view class="member-actions">
        <text class="member-set-active" onTap="onSetActive" data-id="{{item.id}}" data-name="{{item.name}}">设为当前</text>
        <text class="member-delete" a:if="{{item.canDelete}}" onTap="onDelete" data-id="{{item.id}}" data-name="{{item.name}}">删除</text>
      </view>
    </view>
  </view>

  <view class="empty-state" a:if="{{members.length === 0 && !loading}}">
    <text class="empty-icon">👨‍👩‍👧‍👦</text>
    <text class="empty-text">暂无家庭成员</text>
    <text class="empty-desc">点击上方"添加"按钮添加家庭成员</text>
  </view>

  <view class="loading-state" a:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>
</view>