.page-family-members {
  padding: 16px;
  background: #f5f5f5;
  min-height: 100vh;
}

.active-member-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: #e6f4ff;
  border-radius: 8px;
  padding: 10px 14px;
  margin-bottom: 12px;
}

.active-member-text {
  font-size: 13px;
  color: #1677ff;
}

.active-member-action {
  font-size: 12px;
  color: #1677ff;
  font-weight: 500;
}

.header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.header-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.header-action {
  font-size: 14px;
  color: #1677ff;
  padding: 8px 12px;
  border: 1px solid #1677ff;
  border-radius: 16px;
}

.member-list {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}

.member-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid #f0f0f0;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  background: #e6f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  flex-shrink: 0;
}

.member-avatar-text {
  font-size: 18px;
  color: #1677ff;
  font-weight: 600;
}

.member-avatar.active {
  background: #1677ff;
}

.member-avatar.active .member-avatar-text {
  color: #fff;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 4px;
}

.member-name {
  font-size: 15px;
  color: #333;
  font-weight: 500;
  margin-right: 8px;
}

.member-relation {
  font-size: 12px;
  color: #1677ff;
  background: #e6f4ff;
  padding: 2px 8px;
  border-radius: 8px;
}

.member-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.member-meta-text {
  font-size: 12px;
  color: #999;
  margin-right: 12px;
}

.member-badge {
  font-size: 10px;
  color: #fff;
  background: #1677ff;
  padding: 1px 6px;
  border-radius: 6px;
}

.member-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
  flex-shrink: 0;
}

.member-set-active {
  font-size: 11px;
  color: #1677ff;
  padding: 4px 8px;
  border: 1px solid #1677ff;
  border-radius: 10px;
}

.member-delete {
  font-size: 12px;
  color: #ff4d4f;
  padding: 6px 10px;
  border: 1px solid #ff4d4f;
  border-radius: 12px;
  flex-shrink: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 0;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 16px;
  color: #333;
  font-weight: 500;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 13px;
  color: #999;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 40px 0;
}

.loading-text {
  font-size: 14px;
  color: #999;
}