<view class="page-my">
  <view class="profile-card">
    <view class="avatar">
      <text class="avatar-text">{{patientName.charAt(0)}}</text>
    </view>
    <text class="patient-name">{{patientName}}</text>
    <text class="patient-phone">{{phone}}</text>
    <view class="patient-meta" a:if="{{gender || age}}">
      <text class="patient-meta-text" a:if="{{gender}}">{{gender}}</text>
      <text class="patient-meta-text" a:if="{{age}}">{{age}}岁</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" onTap="navigateToProfile">
      <text class="menu-icon">📋</text>
      <text class="menu-label">健康档案</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" onTap="navigateToFamilyMembers">
      <text class="menu-icon">👨‍👩‍👧‍👦</text>
      <text class="menu-label">家庭成员</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="version-info">
    <text class="version-text">智愈健康 v1.0.0</text>
  </view>
</view>