.page-orders {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 24px;
}

/* 列表 */
.order-list {
  padding: 12px;
}

.order-card {
  background: #fff;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 12px;
}

.order-card-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.order-no {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}

.order-status {
  font-size: 13px;
  font-weight: 500;
}

.order-status-PENDING {
  color: #fa8c16;
}

.order-status-PAID {
  color: #1677ff;
}

.order-status-DELIVERING {
  color: #722ed1;
}

.order-status-COMPLETED {
  color: #52c41a;
}

.order-status-CANCELLED {
  color: #999;
}

.order-card-body {
  border-top: 1px solid #f0f0f0;
  padding-top: 10px;
}

.order-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 6px;
}

.order-row:last-child {
  margin-bottom: 0;
}

.order-label {
  font-size: 13px;
  color: #999;
}

.order-value {
  font-size: 13px;
  color: #333;
}

.order-amount {
  font-size: 15px;
  font-weight: 600;
  color: #ff4d4f;
}

/* 空态/加载尾 */
.list-empty {
  padding: 60px 0;
  text-align: center;
}

.list-empty-text {
  font-size: 14px;
  color: #999;
}

.list-footer {
  text-align: center;
  padding: 12px 0;
}

.list-footer-text {
  font-size: 12px;
  color: #ccc;
}
