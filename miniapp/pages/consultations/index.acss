.page-consults {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 24px;
}

/* 列表 */
.consult-list {
  padding: 12px;
}

.consult-card {
  background: #fff;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 12px;
}

.consult-card-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.consult-no {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.consult-no-label {
  font-size: 12px;
  color: #999;
}

.consult-no-value {
  font-family: monospace;
  font-size: 14px;
  color: #333;
  margin-left: 6px;
}

.consult-status {
  font-size: 13px;
  font-weight: 500;
}

.consult-status-WAITING {
  color: #fa8c16;
}

.consult-status-IN_PROGRESS {
  color: #1677ff;
}

.consult-status-COMPLETED {
  color: #52c41a;
}

.consult-card-body {
  border-top: 1px solid #f0f0f0;
  padding-top: 10px;
}

.consult-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 6px;
}

.consult-row:last-child {
  margin-bottom: 0;
}

.consult-label {
  font-size: 13px;
  color: #999;
  flex-shrink: 0;
  margin-right: 12px;
}

.consult-value {
  font-size: 13px;
  color: #333;
  text-align: right;
}

.consult-row-diagnosis {
  align-items: flex-start;
}

.consult-diagnosis {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 空态/加载尾 */
.list-empty {
  padding: 60px 0;
  text-align: center;
}

.list-empty-text {
  font-size: 14px;
  color: #999;
}

.list-footer {
  text-align: center;
  padding: 12px 0;
}

.list-footer-text {
  font-size: 12px;
  color: #ccc;
}
