<view class="page-chat">
  <!-- 顶栏 -->
  <view class="chat-header">
    <view class="chat-header-btn" onTap="openSessions">
      <text class="chat-header-btn-icon">☰</text>
    </view>
    <text class="chat-header-title">{{sessionTitle || 'AI 智能助手'}}</text>
    <view class="chat-header-right" />
  </view>

  <!-- 消息区 -->
  <scroll-view class="chat-body" scroll-y scroll-into-view="{{scrollIntoView}}" scroll-with-animation>
    <view class="chat-welcome" a:if="{{messages.length === 0 && !loadingHistory}}">
      <view class="chat-welcome-icon">🤖</view>
      <text class="chat-welcome-title">您好，我是智愈健康助手</text>
      <text class="chat-welcome-desc">可以问我：挂号、用药、症状咨询等，也可以帮您办理预约</text>
    </view>
    <view class="chat-loading" a:if="{{loadingHistory}}">
      <text class="chat-loading-text">加载中...</text>
    </view>

    <view class="chat-msg" a:for="{{messages}}" a:key="key" id="msg-{{item.key}}">
      <!-- 用户气泡（右侧） -->
      <view class="msg-row msg-row-user" a:if="{{item.role === 'USER'}}">
        <view class="msg-bubble msg-bubble-user">{{item.content}}</view>
      </view>

      <!-- 工具调用轨迹（灰色提示条） -->
      <view class="msg-row msg-row-tool" a:if="{{item.role === 'TOOL'}}">
        <view class="msg-tool">
          <text class="msg-tool-icon">⚙</text>
          <text class="msg-tool-text">{{item.content}}</text>
        </view>
      </view>

      <!-- AI 气泡（左侧，含卡片/免责/失败重试） -->
      <view class="msg-row msg-row-ai" a:if="{{item.role === 'ASSISTANT'}}">
        <view class="msg-avatar"><text class="msg-avatar-text">AI</text></view>
        <view class="msg-content">
          <view class="msg-bubble msg-bubble-ai">
            <text a:if="{{item.streaming && !item.content}}" class="msg-typing">正在思考…</text>
            <text a:else>{{item.content}}</text>
          </view>

          <!-- 确认卡片（card 帧，仅当轮展示） -->
          <view class="msg-card" a:if="{{item.card}}" data-index="{{index}}" onTap="onCardTap">
            <view class="msg-card-title">{{item.card.title}}</view>

            <!-- 购药确认卡片：展示药店/金额/药品明细 -->
            <block a:if="{{item.card.type === 'order_confirm'}}">
              <view class="msg-card-payload">
                <view class="msg-card-row">
                  <text class="msg-card-label">药店</text>
                  <text class="msg-card-value">{{item.card.payload.pharmacyName}}</text>
                </view>
                <view class="msg-card-row">
                  <text class="msg-card-label">总金额</text>
                  <text class="msg-card-value">¥{{item.card.payload.totalAmount}}</text>
                </view>
                <view class="msg-card-row" a:if="{{item.card.payload.items}}">
                  <text class="msg-card-label">药品</text>
                  <text class="msg-card-value">{{item.card.payload.items.length}} 种</text>
                </view>
              </view>
              <!-- 购药成功凭证卡片（本地渲染 confirm 返回的 DrugOrderVO） -->
              <view class="msg-card-voucher" a:if="{{item.card.status === 'success' && item.card.voucherData}}">
                <text class="msg-card-voucher-text">✅ 购药成功</text>
                <view class="msg-card-voucher-detail">
                  <text class="msg-card-voucher-line">订单号：{{item.card.voucherData.id}}</text>
                  <text class="msg-card-voucher-line" a:if="{{item.card.voucherData.pharmacyName}}">药店：{{item.card.voucherData.pharmacyName}}</text>
                  <text class="msg-card-voucher-line" a:if="{{item.card.voucherData.totalAmount}}">金额：¥{{item.card.voucherData.totalAmount}}</text>
                  <text class="msg-card-voucher-line" a:if="{{item.card.voucherData.status}}">状态：{{item.card.voucherData.status}}</text>
                </view>
                <text class="msg-card-voucher-hint">✅ 已为您设置用药提醒</text>
              </view>
              <view class="msg-card-status" a:if="{{item.card.status === 'fail'}}">
                <text class="msg-card-fail">✕ {{item.card.result || '操作失败'}}</text>
              </view>
              <view class="msg-card-btns" a:if="{{!item.card.status || item.card.status === 'idle'}}">
                <view class="msg-card-btn msg-card-btn-primary" data-index="{{index}}" catchTap="onCardTap">确认购药</view>
                <view class="msg-card-btn" data-index="{{index}}" catchTap="onCardCancel">取消</view>
              </view>
              <view class="msg-card-status" a:if="{{item.card.status === 'loading'}}">
                <text class="msg-card-loading">处理中…</text>
              </view>
            </block>

            <!-- 挂号确认卡片（通用模板，保留原逻辑） -->
            <block a:else>
              <view class="msg-card-payload">
                <view class="msg-card-row" a:for="{{item.card.payload}}" a:for-item="pv" a:for-index="pk" a:key="pk" a:if="{{pk !== 'confirmToken' && pk !== 'draftKey' && pk !== 'scheduleId' && pk !== 'familyMemberId'}}">
                  <text class="msg-card-label">{{pk}}</text>
                  <text class="msg-card-value">{{pv}}</text>
                </view>
              </view>
              <!-- 成功后凭证卡片 -->
              <view class="msg-card-voucher" a:if="{{item.card.status === 'success'}}">
                <text class="msg-card-voucher-text">✅ {{item.card.result || '操作成功'}}</text>
                <text class="msg-card-voucher-hint">就诊前 1 天会提醒您</text>
              </view>
              <view class="msg-card-status" a:if="{{item.card.status === 'fail'}}">
                <text class="msg-card-fail">✕ {{item.card.result || '操作失败'}}</text>
              </view>
              <view class="msg-card-btns" a:if="{{!item.card.status || item.card.status === 'idle'}}">
                <view class="msg-card-btn msg-card-btn-primary" data-index="{{index}}" catchTap="onCardTap">确认挂号</view>
                <view class="msg-card-btn" data-index="{{index}}" catchTap="onCardCancel">取消</view>
              </view>
              <view class="msg-card-status" a:if="{{item.card.status === 'loading'}}">
                <text class="msg-card-loading">处理中…</text>
              </view>
            </block>
          </view>

          <!-- 免责声明 -->
          <view class="msg-disclaimer" a:if="{{!item.failed}}">AI 建议仅供参考，不能替代医生诊断</view>

          <!-- 失败气泡 + 重试 -->
          <view class="msg-failed" a:if="{{item.failed}}">
            <text class="msg-failed-text">{{item.errorText || '发送失败'}}</text>
            <view class="msg-retry" data-index="{{index}}" onTap="onRetry">重试</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 输入区 -->
  <view class="chat-input-bar">
    <textarea
      class="chat-input"
      value="{{inputValue}}"
      onInput="onInput"
      disabled="{{sending}}"
      placeholder="{{sending ? 'AI 回复中，请稍候…' : '请输入您的问题'}}"
      placeholder-class="chat-input-placeholder"
      maxlength="500"
      auto-height
    />
    <view class="chat-send {{(sending || !inputValue) ? 'chat-send-disabled' : ''}}" onTap="onSend">
      <text class="chat-send-text">发送</text>
    </view>
  </view>

  <!-- 会话列表弹层 -->
  <view class="session-mask" a:if="{{showSessions}}" onTap="closeSessions" />
  <view class="session-panel" a:if="{{showSessions}}">
    <view class="session-panel-header">
      <text class="session-panel-title">会话列表</text>
      <view class="session-new" onTap="onNewSession">
        <text class="session-new-text">＋ 新建会话</text>
      </view>
    </view>
    <scroll-view class="session-list" scroll-y>
      <view
        class="session-item {{item.id === sessionId ? 'session-item-active' : ''}}"
        a:for="{{sessions}}"
        a:key="id"
        data-id="{{item.id}}"
        onTap="onSwitchSession"
      >
        <view class="session-item-main">
          <text class="session-item-title">{{item.title}}</text>
          <text class="session-item-time">{{item.updatedAt}}</text>
        </view>
        <view class="session-item-del" data-id="{{item.id}}" catchTap="onDeleteSession">
          <text class="session-item-del-text">删除</text>
        </view>
      </view>
      <view class="session-empty" a:if="{{sessions.length === 0}}">
        <text class="session-empty-text">暂无历史会话</text>
      </view>
    </scroll-view>
  </view>
</view>
