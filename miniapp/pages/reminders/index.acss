.page-reminders {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 24px;
}

/* 列表 */
.remind-list {
  padding: 12px;
}

.remind-card {
  background: #fff;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 12px;
}

.remind-card-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.remind-drug {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.remind-status {
  font-size: 13px;
  font-weight: 500;
}

.remind-status-ACTIVE {
  color: #1677ff;
}

.remind-status-DONE {
  color: #999;
}

.remind-card-body {
  border-top: 1px solid #f0f0f0;
  padding-top: 10px;
}

.remind-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 6px;
}

.remind-row:last-child {
  margin-bottom: 0;
}

.remind-label {
  font-size: 13px;
  color: #999;
  flex-shrink: 0;
  margin-right: 12px;
}

.remind-value {
  font-size: 13px;
  color: #333;
  text-align: right;
}

.remind-next {
  color: #1677ff;
  font-weight: 500;
}

/* 空态 */
.list-empty {
  padding: 60px 0;
  text-align: center;
}

.list-empty-text {
  font-size: 14px;
  color: #999;
}
