# backend/ - Java 后端应用配置 (本机运行, 连接 VM 上的中间件)
# 用法: cp .env.example .env 后按需修改
#
# 本机运行时通过环境变量注入. 02 ticket 初始化 Spring Boot 骨架时,
# application.yml 用 ${VAR} 引用此处变量, 变量名以本文件为准.
#
# 中间件部署在 VM (192.168.100.128), 本机通过局域网连接.

# ---------- PostgreSQL ----------
DB_HOST=<vm-ip>
DB_PORT=5432
DB_USER=smartmed
DB_PASSWORD=<change-me>
DB_NAME=smartmed

# ---------- Redis ----------
REDIS_HOST=<vm-ip>
REDIS_PORT=6379
REDIS_PASSWORD=<change-me>

# ---------- Neo4j ----------
NEO4J_URI=bolt://<vm-ip>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<change-me>

# ---------- 应用密钥 ----------
# JWT 签名密钥 (生产请替换为强随机值)
JWT_SECRET=<change-me>
# Agent 网关共享密钥 (Java <-> Python, 见 CONTEXT 第 5 节)
AGENT_SECRET=<change-me>

# ---------- 服务 ----------
# Java 后端监听端口 (Agent 调本机 Java 网关用 http://localhost:8080)
SERVER_PORT=8080
