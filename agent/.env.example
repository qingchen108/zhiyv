# agent/ - Python Agent 应用配置 (本机运行)
# 用法: cp .env.example .env 后按需修改
#
# 本机运行时通过环境变量注入. 09 ticket 初始化 LangGraph 骨架时,
# 用 os.environ / pydantic-settings 读取此处变量, 变量名以本文件为准.
#
# 原则: Python 不直接访问任何数据库, 所有数据访问经 Java /api/agent/tools/* (见 CONTEXT 第 5 节).
#       因此本文件只含 LLM 配置 + Java 网关地址 + Agent 鉴权密钥, 无 DB/Redis/Neo4j 连接信息.

# ---------- LLM 配置 (09 ticket 填入真实值) ----------
# 火山方舟 coding 端点仅兼容 Anthropic Messages API 协议 (OpenAI 路径不存在)
# 例: LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
#     LLM_MODEL=doubao-seed-2.1-turbo (需在方舟控制台开通后可用)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---------- Java 网关 ----------
# 本机后端地址, Agent 调工具用 (Java 默认监听 8080)
JAVA_GATEWAY_URL=http://localhost:8080

# ---------- Agent 鉴权 ----------
# 与 Java 共享的密钥, 请求头 X-Agent-Secret (须与 backend/.env 的 AGENT_SECRET 一致)
# 双向校验: Python→Java 调工具、Java→Python 转发 chat 均带同一密钥 (见 CONTEXT 第 5 节)
AGENT_SECRET=<change-me>

# ---------- 验证开关 (09 ticket) ----------
# true: 绕过 LLM, 把最后一条用户消息回显为 delta 事件 (链路 smoke, 无需 API key)
# false: 真实 LLM 意图分类 + mock 意图节点回复 (启动时做 LLM 连通性校验)
AGENT_ECHO_MODE=false
