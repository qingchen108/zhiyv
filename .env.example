# SmartMed 基础设施环境变量 (docker-compose 使用, 在 VM 上)
# 用法: cp .env.example .env 后按需修改
#
# 本文件仅含中间件编排参数, 供 docker-compose.yml 读取.
# 应用层配置 (DB_HOST / LLM_API_KEY / JWT_SECRET / AGENT_SECRET 等) 已拆分至各端:
#   - backend/.env.example  (Java 后端: 中间件连接 + JWT + Agent 密钥)
#   - agent/.env.example    (Python Agent: LLM + Java 网关地址 + Agent 密钥)
#
# B 端账号明文密码 (库内存 BCrypt 哈希, 02 后端须配 BCryptPasswordEncoder Bean):
#   admin  / admin123
#   doctor / doctor123
# C 端演示患者: 免密, demo-login 按预设 patient.id=1 签发 JWT

# ---------- PostgreSQL ----------
POSTGRES_USER=smartmed
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=smartmed
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=<change-me>
REDIS_PORT=6379

# ---------- Neo4j ----------
NEO4J_USER=neo4j
NEO4J_PASSWORD=<change-me>
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- 应用层配置已拆分 ----------
# JWT_SECRET / AGENT_SECRET 见 backend/.env.example 与 agent/.env.example
