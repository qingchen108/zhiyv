# SmartMed 基础设施环境变量 (docker-compose 使用)
# 用法: cp .env.example .env 后按需修改
#
# 注意: 本文件仅含基础设施变量. 各端应用层变量 (如 LLM_API_KEY/LLM_BASE_URL/LLM_MODEL)
#       不在此列, 由 agent/ 端的 .env.example 自行维护 (见 09 ticket).
#
# B 端账号明文密码 (库内存 BCrypt 哈希, 02 后端须配 BCryptPasswordEncoder Bean):
#   admin  / admin123
#   doctor / doctor123
# C 端演示患者: 免密, demo-login 按预设 patient.id=1 签发 JWT

# ---------- PostgreSQL ----------
POSTGRES_USER=smartmed
POSTGRES_PASSWORD=smartmed
POSTGRES_DB=smartmed
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=smartmed
REDIS_PORT=6379

# ---------- Neo4j ----------
NEO4J_USER=neo4j
NEO4J_PASSWORD=smartmed
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- 应用共享密钥 (02 后端使用) ----------
# JWT 签名密钥 (生产请替换为强随机值)
JWT_SECRET=smartmed-dev-jwt-secret-change-me
# Agent 网关共享密钥 (Java <-> Python, 见 CONTEXT 第 5 节)
AGENT_SECRET=smartmed-dev-agent-secret-change-me
